<article class="post-card">
  <h2 class="post-card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
  {% if post.data.excerpt %}
  <p class="post-card-excerpt">{{ post.data.excerpt }}</p>
  {% endif %}
  {% if post.data.tag %}
  <span class="tag-pill">{{ post.data.tag }}</span>
  {% endif %}
  <div class="post-card-meta">
    <span class="avatar">{{ site.author | initial }}</span>
    <span class="author-name">{{ site.author }}</span>
    <span class="meta-date">{{ post.data.date | dateShort }}</span>
  </div>
</article>
<hr class="post-divider">
